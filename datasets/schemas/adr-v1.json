{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adr-v1.json",
  "title": "ADR Forge generated ADR v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "title", "status", "context", "facts", "assumptions",
    "unresolved_questions", "constraints", "alternatives", "decision", "rationale",
    "positive_consequences", "negative_consequences", "risks", "review_triggers",
    "confidence", "reference_ids"
  ],
  "properties": {
    "schema_version": {"const": "adr-v1"},
    "title": {"type": "string", "minLength": 3, "maxLength": 200},
    "status": {"enum": ["provisional", "proposed"]},
    "context": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "facts": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
    "unresolved_questions": {
      "type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/question"}
    },
    "constraints": {"type": "array", "items": {"type": "string"}},
    "alternatives": {"type": "array", "items": {"$ref": "#/$defs/alternative"}},
    "decision": {"type": ["string", "null"]},
    "rationale": {"type": "array", "items": {"$ref": "#/$defs/rationale"}},
    "positive_consequences": {"type": "array", "items": {"type": "string"}},
    "negative_consequences": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"$ref": "#/$defs/risk"}},
    "review_triggers": {"type": "array", "items": {"$ref": "#/$defs/review_trigger"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reference_ids": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "assumption": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "impact", "confidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "question", "impact"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1}
      }
    },
    "alternative": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "name", "summary", "viable", "rejection_reason", "benefits", "drawbacks",
        "constraint_ids"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "viable": {"type": "boolean"},
        "rejection_reason": {"type": ["string", "null"]},
        "benefits": {"type": "array", "items": {"type": "string"}},
        "drawbacks": {"type": "array", "items": {"type": "string"}},
        "constraint_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "rationale": {
      "type": "object", "additionalProperties": false,
      "required": ["claim", "evidence_kind", "evidence_id"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "evidence_kind": {"enum": ["fact", "assumption", "reference"]},
        "evidence_id": {"type": "string", "minLength": 1}
      }
    },
    "risk": {
      "type": "object", "additionalProperties": false,
      "required": ["description", "likelihood", "impact", "mitigation"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "likelihood": {"enum": ["low", "medium", "high"]},
        "impact": {"enum": ["low", "medium", "high"]},
        "mitigation": {"type": "string", "minLength": 1}
      }
    },
    "review_trigger": {
      "type": "object", "additionalProperties": false,
      "required": ["metric", "operator", "threshold", "unit"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "operator": {"enum": ["gt", "gte", "lt", "lte", "eq"]},
        "threshold": {"type": "number"},
        "unit": {"type": "string", "minLength": 1}
      }
    }
  }
}
