# Network: the MVP must remain bound to loopback.
ADR_FORGE_HOST=127.0.0.1
ADR_FORGE_PORT=8000
ADR_FORGE_WEB_HOST=127.0.0.1
ADR_FORGE_WEB_PORT=5173

# Local metadata and artifact storage.
ADR_FORGE_DATABASE_URL=sqlite+aiosqlite:///./var/adr-forge.sqlite3
ADR_FORGE_ARTIFACT_ROOT=./var/artifacts
ADR_FORGE_ARTIFACT_WARNING_BYTES=42949672960
ADR_FORGE_ARTIFACT_LIMIT_BYTES=53687091200

# Existing Knowledge Hub retrieval API. Never commit the real bearer token.
KNOWLEDGE_HUB_BASE_URL=http://127.0.0.1:8001
KNOWLEDGE_HUB_TOKEN=

# Hugging Face access is optional for public artifacts.
HF_TOKEN=
HF_HOME=./var/huggingface

# Initial pinned model configuration.
ADR_FORGE_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
ADR_FORGE_MODEL_REVISION=cdbee75f17c01a7cc42f958dc650907174af0554
ADR_FORGE_MODEL_TRUST_REMOTE_CODE=false
